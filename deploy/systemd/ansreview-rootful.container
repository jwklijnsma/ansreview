# ansreview web UI as a rootful Podman Quadlet (system service, started at boot).
# For the rootless variant (your own user, ~/git) use ansreview.container.
#
#   openssl rand -hex 24 | tr -d '\n' | sudo podman secret create ansreview-token -
#   sudo mkdir -p /etc/ansreview
#   sudo install -m 600 ansreview.env.example /etc/ansreview/ansreview.env   # required (may stay as is)
#   sudo cp ansreview-rootful.container /etc/containers/systemd/ansreview.container
#   # edit the Volume= path and User=/Group= below, then:
#   sudo systemctl daemon-reload
#   sudo systemctl start ansreview
#   sudo systemctl enable --now podman-auto-update.timer    # daily image updates
#
# Logs: journalctl -u ansreview -f
# Token: sudo podman secret inspect --showsecret --format '{{.SecretData}}' ansreview-token
# (No keep-id here: that only exists for rootless Podman. The [Install] section
#  makes it start at boot; `systemctl enable` is not needed for Quadlets.)

[Unit]
Description=ansreview: review Ansible code with ansible-lint and a local Ollama model
Documentation=https://github.com/jwklijnsma/ansreview
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=ansreview
Image=ghcr.io/jwklijnsma/ansreview:latest
AutoUpdate=registry
PublishPort=127.0.0.1:8765:8765

# The folder with the repositories to review (must exist). :z relabels for SELinux.
Volume=/srv/ansible:/repos:z
# ZIP uploads survive restarts and updates.
Volume=ansreview-data:/home/ansreview/.cache/ansreview:U

# Run as the owner of that folder (see `stat -c '%u:%g' /srv/ansible`), so reports
# and fixes are written as that user and never as root.
User=1000
Group=1000
# No user namespace: with one (keep-id, or userns=auto in containers.conf) rootful
# Podman must make an ID-mapped copy of the image, which fails on many hosts
# ("creating an ID-mapped copy of layer", exit 125), e.g. in LXC.
UserNS=host

# The access token, from the Podman secret created above.
Secret=ansreview-token,type=env,target=ANSREVIEW_WEB_TOKEN
# Settings (model, Ollama URL, ...). The file must exist: Quadlet hands this path to
# `podman --env-file`, which has no "optional" form. An unchanged copy of the example is fine.
EnvironmentFile=/etc/ansreview/ansreview.env
# Ollama on this host (it must listen on more than 127.0.0.1). For Ollama on another
# machine, change this line.
Environment=OLLAMA_HOST=http://host.containers.internal:11434

NoNewPrivileges=true
DropCapability=all

HealthCmd=python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8765/', timeout=4)"
HealthInterval=30s
HealthStartPeriod=10s
StopSignal=SIGINT
StopTimeout=30

[Service]
Restart=on-failure
RestartSec=10
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
