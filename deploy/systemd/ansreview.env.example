# Settings for the ansreview container. Keep this file private (chmod 600): it holds
# the access token. One KEY=value per line; comments only on their own line.

# Access token for the web UI. Generate one with: openssl rand -hex 24
# (hex, not base64: a "+" in the token would break the ?token= link)
ANSREVIEW_WEB_TOKEN=change-me

# Model (default qwen2.5-coder:14b) and context size.
#ANSREVIEW_MODEL=qwen2.5-coder:14b
#ANSREVIEW_NUM_CTX=16384

# Ollama on another machine (Docker service). With the Podman Quadlet, change the
# Environment=OLLAMA_HOST line in ansreview.container instead.
#OLLAMA_HOST=http://gpu-box.example:11434

# Report language (en or nl) and the severity that marks a scan as failed.
#ANSREVIEW_LANGUAGE=en
#ANSREVIEW_FAIL_ON=high
